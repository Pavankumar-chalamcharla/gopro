<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        V0.2 note: no CAMERA runtime permission is requested yet.
        This build only reads static CameraCharacteristics via
        CameraManager#getCameraCharacteristics(), which Android does NOT
        gate behind the CAMERA permission (only opening a capture session
        does). The CAMERA permission — with proper runtime request/denial
        handling — will be added starting at V0.6 (camera recorder / live
        preview). See docs/ROADMAP.md.

        All hardware <uses-feature> below are android:required="false" on
        purpose: this app must remain installable on devices that lack a
        gyroscope or a camera, since reporting "Level 0 / Unsupported" to
        the user is a valid, intended product state, not an install-time
        rejection (spec section 3, LEVEL 0).
    -->

    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
        Required since Android 12 (API 31) to request sensor sampling at
        SensorManager.SENSOR_DELAY_FASTEST (i.e. a requested period of 0
        microseconds — "as fast as the driver will go"), which
        SensorQualityCollector uses for the V0.3 test. This is a "normal"
        permission — declaring it here is sufficient, no runtime request
        dialog is shown to the user.
    -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EisCamera">

        <activity
            android:name="com.eiscamera.app.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
